# ─── Build output ─────────────────────────────────────────────────────────────
build/
build-*/
Build/
out/
bin/
dist/

# ─── CMake ────────────────────────────────────────────────────────────────────
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Makefile
*.cmake
!CMakeLists.txt          # keep the hand-written one
CMakeUserPresets.json    # local preset overrides — not for sharing

# ─── Ninja ────────────────────────────────────────────────────────────────────
*.ninja
.ninja_deps
.ninja_log
build.ninja

# ─── Compiled objects ─────────────────────────────────────────────────────────
*.o
*.obj
*.slo
*.lo
*.d        # dependency files

# ─── Precompiled headers ──────────────────────────────────────────────────────
*.gch
*.pch

# ─── Libraries ────────────────────────────────────────────────────────────────
*.a
*.la
*.lai
*.lib
*.so
*.so.*
*.dylib
*.dll

# ─── Executables & debug info ─────────────────────────────────────────────────
*.exe
*.out
*.app
*.ilk
*.pdb
*.dwo
*.exp      # Windows export files

# ─── vcpkg ────────────────────────────────────────────────────────────────────
vcpkg_installed/

# ─── Runtime output (logs, recordings) ────────────────────────────────────────
log/
logs/
*.csv      # control loop CSVs — can be large
*.bag      # ROS bags if ever used

# ─── IDEs ─────────────────────────────────────────────────────────────────────

# Visual Studio / VS Code
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.VC.db
*.VC.opendb
.vscode/launch.json      # personal debug configs; keep tasks/settings if useful
# If you want to ignore all of .vscode, uncomment the line below instead:
# .vscode/

# CLion / JetBrains
.idea/
cmake-build-*/

# Qt Creator
*.pro.user

# ─── OS generated ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*~
.cache/
Testing/
compile_commands.json    # generated by cmake -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
                         # (useful locally but IDE-specific — add to .git/info/exclude
                         #  if you want it untracked but present)
